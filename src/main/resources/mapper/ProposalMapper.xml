<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mediation.homepage.domain.proposal.mapper.ProposalMapper">

    <resultMap id="proposalResultMap" type="com.mediation.homepage.domain.proposal.entity.Proposal">
        <id property="proposalId" column="proposal_id"/>
        <result property="requestId" column="request_id"/>
        <result property="message" column="message"/>
        <result property="proposalBudget" column="proposal_budget"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="createProposal">
        INSERT INTO proposal
        (proposal_id, request_id, message, proposal_budget, status, created_at, updated_at)
        VALUES
        (#{proposalId}, #{requestId}, #{message}, #{proposalBudget}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

</mapper>