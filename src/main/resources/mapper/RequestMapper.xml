<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mediation.homepage.domain.request.mapper.RequestMapper">

    <!-- resultMap을 추가하여 명시적으로 매핑 -->
    <resultMap id="requestResultMap" type="com.mediation.homepage.domain.request.entity.Request">
        <result property="requestId" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="budget" column="budget"/>
        <result property="status" column="status" javaType="com.mediation.homepage.domain.request.status.RequestStatus"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deadline" column="deadline"/>
    </resultMap>

    <!-- 의뢰 등록 -->
    <insert id="createRequest" parameterType="com.mediation.homepage.domain.request.entity.Request"
    useGeneratedKeys="true"
    keyProperty="requestId">
        INSERT INTO request(title, description, budget, status, deadline, created_at, updated_at)
        VALUES (#{title},
                #{description},
                #{budget},
                #{status,typeHandler=com.mediation.homepage.global.typehandler.RequestStatusTypeHandler},
                #{deadline},
                NOW(),
                #{updatedAt})
    </insert>

    <!-- 의뢰 상세 조회 -->
    <select id="findRequestById" resultMap="requestResultMap">
        SELECT * FROM request WHERE id = #{requestId}
    </select>

    <delete id="deleteRequestById">
        DELETE FROM request WHERE id = #{requestId}
    </delete>

    <!-- 의뢰 수정 -->
    <update id ="updateRequestById" parameterType="com.mediation.homepage.domain.request.dto.resp.RequestRespDto">
        UPDATE request
        SET
            title = #{respdto.title},
            description = #{respdto.description},
            budget = #{respdto.budget},
            deadline = #{respdto.deadline},
            status = #{respdto.status, typeHandler=com.mediation.homepage.global.typehandler.RequestStatusTypeHandler},
            updated_at = NOW() <!-- status 추가 -->
        WHERE id = #{requestId}
    </update>

    <!-- 의뢰 목록 조회 (페이징 + 검색 + 정렬 포함) -->
    <select id="findAllRequests" resultMap="requestResultMap">
        SELECT * FROM request
        <where>
            <if test="keyword != null and keyword != ''">
               <choose>
                   <when test="searchType == 'title'">
                       AND title LIKE CONCAT('%', #{keyword}, '%')
                   </when>
                 <when test="searchType == 'content'">
                     AND description LIKE CONCAT('%', #{keyword}, '%')
                 </when>
                 <when test="searchType == 'title_content'">
                     AND (title LIKE CONCAT('%', #{keyword}, '%') OR description LIKE CONCAT('%', #{keyword}, '%'))
                 </when>
               </choose>
            </if>
        </where>
        ORDER BY
            <choose>
                <when test="sortBy == 'title'"> title</when>
                <when test="sortBy == 'created_at'">created_at</when>
                <otherwise>created_at</otherwise>
            </choose>
            <choose>
                <when test="order == 'asc'">ASC</when>
                <otherwise>DESC</otherwise>
            </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 의뢰 개수 카운트 (검색 조건 포함) -->
    <select id="countRequestsWithFilter" resultType="long">
       SELECT COUNT(*) FROM request
       <where>
           <if test="keyword != null and keyword != ''">
               <choose>
                <when test="searchType == 'title'">
                    AND title LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="searchType == 'content'">
                    AND description LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="searchType == 'title_content'">
                    AND (title LIKE CONCAT('%', #{keyword}, '%')
                    OR description LIKE CONCAT('%', #{keyword}, '%'))
                </when>
               </choose>
           </if>
       </where>
    </select>
</mapper>
